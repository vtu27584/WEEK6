class Result {

    /*
     * Complete the 'palindromeIndex' function below.
     *
     * The function is expected to return an INTEGER.
     * The function accepts STRING s as parameter.
     */
    public static int palindromeIndex(String s) {
        int left = 0;
        int right = s.length() - 1;

        while (left < right) {
            // If characters mismatch, we must eliminate one of them
            if (s.charAt(left) != s.charAt(right)) {
                // Check if removing the left character makes the rest a palindrome
                if (isPalindrome(s, left + 1, right)) {
                    return left;
                }
                // Check if removing the right character makes the rest a palindrome
                if (isPalindrome(s, left, right - 1)) {
                    return right;
                }
                // If neither works, it's impossible (though the problem guarantees a solution if one exists)
                return -1;
            }
            left++;
            right--;
        }

        // Already a palindrome
        return -1;
    }

    // Helper function to check if a specific substring is a palindrome
    private static boolean isPalindrome(String s, int left, int right) {
        while (left < right) {
            if (s.charAt(left) != s.charAt(right)) {
                return false;
            }
            left++;
            right--;
        }
        return true;
    }
}

