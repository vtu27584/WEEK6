import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;

class Code6 {
    public List<Integer> findAnagrams(String s, String p) {
        List<Integer> result = new ArrayList<>();
        
        // Edge case: if s is shorter than p, an anagram is impossible
        if (s == null || p == null || s.length() < p.length()) {
            return result;
        }
        
        int ns = s.length();
        int np = p.length();
        
        // Frequency arrays for lowercase English letters
        int[] pCount = new int[26];
        int[] sCount = new int[26];
        
        // Build the reference frequency for p and the first window of s
        for (int i = 0; i < np; i++) {
            pCount[p.charAt(i) - 'a']++;
            sCount[s.charAt(i) - 'a']++;
        }
        
        // Check if the very first window matches
        if (Arrays.equals(pCount, sCount)) {
            result.add(0);
        }
        
        // Slide the window across string s
        for (int i = np; i < ns; i++) {
            // Add the new character entering the window
            sCount[s.charAt(i) - 'a']++;
            
            // Remove the old character leaving the window
            sCount[s.charAt(i - np) - 'a']--;
            
            // Compare the frequency configurations
            if (Arrays.equals(pCount, sCount)) {
                result.add(i - np + 1);
            }
        }
        
        return result;
    }
}
